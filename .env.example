# ---------- LLM (Groq, OpenAI-compatible) ----------
GROQ_API_KEY=gsk_your_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Model HakDaar uses for event extraction + replies
GROQ_MODEL=openai/gpt-oss-120b

# ---------- Hindsight memory server ----------
HINDSIGHT_URL=http://localhost:8888
# Model the Hindsight server itself uses for fact extraction / reflect
HINDSIGHT_LLM_MODEL=openai/gpt-oss-20b

# ---------- App ----------
DATABASE_PATH=hakdaar.db
# Comma-separated origins allowed to call the API (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# ---------- Hosting (docker compose, see DEPLOY.md) ----------
# On a server with the domain pointed at it:  SITE_ADDRESS=hakdaar.me, www.hakdaar.me
# Behind a Cloudflare Tunnel from your own computer:  SITE_ADDRESS=:80
SITE_ADDRESS=:80
# Random string that signs login sessions (e.g. the output of: openssl rand -hex 32)
SESSION_SECRET=

# ---------- Admin dashboard (keep these only in .env, never in code) ----------
# The account with this phone number becomes the admin; its PIN is always reset to ADMIN_PIN on startup.
ADMIN_PHONE=
ADMIN_NAME=
ADMIN_PIN=
